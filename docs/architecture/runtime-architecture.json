  "cards": [
    {
      "dot": "cyan",
      "title": "请求与失败语义",
      "items": [
        "operation_timeout_ms 覆盖排队、写入与等待 ACK",
        "截止看门狗只唤醒条件变量，请求协程负责中止",
        "NotSent：字节从未进入 socket 写调用",
        "OutcomeUnknown：写已开始但未获确认"
      ]
    },
    {
      "dot": "violet",
      "title": "背压与控制通道",
      "items": [
        "控制包独占 control_capacity 保留槽位",
        "写循环先发控制包，PUBACK/PINGREQ 不被业务堵住",
        "控制队列耗尽即 ProtocolError 中止，绝不丢包",
        "会话 abort 时每个 pending 恰好结算一次"
      ]
    },
    {
      "dot": "emerald",
      "title": "重连与会话恢复",
      "items": [
        "仅 CleanSession=true，每次 CONNACK 递增 generation",
        "先恢复已确认订阅，再发 Connected(generation)",
        "有界指数退避加每客户端 xorshift 抖动",
        "QoS 0 写完即返回，QoS 1 需匹配 PUBACK"
      ]
    },
    {
      "dot": "amber",
      "title": "信任边界与范围",
      "items": [
        "TLS 只做服务端认证：SystemRoots / CustomCA",
        "无关闭校验的开关；password 必须配 username",
        "ClientStats 只含计数与队列占用",
        "无 QoS 2、MQTT 5、离线队列与 WebSocket"
      ]
    }
  ]
